# Application Settings
PROJECT_NAME="DocIntel AI"
DEBUG=True
API_V1_STR="/api/v1"

# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=

# PostgreSQL Database Configuration (Local native connection without Docker)
